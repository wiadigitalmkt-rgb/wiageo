# ── Frontend (Vite) — usado no navegador, prefixo VITE_ obrigatório ──────────
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=coloque_a_anon_key_aqui

# ── Backend (Vercel Functions em /api) — NUNCA prefixar com VITE_ ───────────
# Nunca exponha a service role key no frontend.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui

# E-mail de alerta (CTO offline/restaurada) via https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
ALERT_FROM_EMAIL="WIAGEO Monitor <alertas@seudominio.com.br>"
ALERT_FALLBACK_EMAIL=seuemail@exemplo.com
